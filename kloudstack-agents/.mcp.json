{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@0.6.2"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "@vercel/mcp-adapter@0.4.2", "stdio"],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}"
      }
    },
    "netlify": {
      "command": "npx",
      "args": ["-y", "netlify-mcp@0.1.0"],
      "env": {
        "NETLIFY_TOKEN": "${NETLIFY_TOKEN}"
      }
    },
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/agent-toolkit@0.1.0", "mcp"],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      }
    },
    "atlassian": {
      "command": "npx",
      "args": ["-y", "@atlassian/mcp-server@1.0.0"],
      "env": {
        "ATLASSIAN_TOKEN": "${ATLASSIAN_TOKEN}",
        "ATLASSIAN_EMAIL": "${ATLASSIAN_EMAIL}",
        "ATLASSIAN_BASE_URL": "${ATLASSIAN_BASE_URL}"
      }
    },
    "google-workspace": {
      "command": "npx",
      "args": ["-y", "@googleapis/mcp-server@0.1.0"],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_REFRESH_TOKEN": "${GOOGLE_REFRESH_TOKEN}"
      }
    },
    "microsoft-365": {
      "command": "npx",
      "args": ["-y", "@microsoft/mcp-server-graph@0.1.0"],
      "env": {
        "MICROSOFT_TENANT_ID": "${MICROSOFT_TENANT_ID}",
        "MICROSOFT_CLIENT_ID": "${MICROSOFT_CLIENT_ID}",
        "MICROSOFT_CLIENT_SECRET": "${MICROSOFT_CLIENT_SECRET}"
      }
    },
    "canva": {
      "command": "npx",
      "args": ["-y", "@canva/mcp-server@0.1.0"],
      "env": {
        "CANVA_TOKEN": "${CANVA_TOKEN}"
      }
    },
    "adobe": {
      "command": "npx",
      "args": ["-y", "@adobe/mcp-server@0.1.0"],
      "env": {
        "ADOBE_CLIENT_ID": "${ADOBE_CLIENT_ID}",
        "ADOBE_CLIENT_SECRET": "${ADOBE_CLIENT_SECRET}"
      }
    },
    "heygen": {
      "command": "npx",
      "args": ["-y", "@heygen/hyperframes-mcp@0.1.0"],
      "env": {
        "HEYGEN_TOKEN": "${HEYGEN_TOKEN}"
      }
    },
    "lucid": {
      "command": "npx",
      "args": ["-y", "@lucid/mcp-server@0.1.0"],
      "env": {
        "LUCID_TOKEN": "${LUCID_TOKEN}"
      }
    },
    "miro": {
      "command": "npx",
      "args": ["-y", "@mirohq/mcp-server@0.1.0"],
      "env": {
        "MIRO_TOKEN": "${MIRO_TOKEN}"
      }
    },
    "descript": {
      "command": "npx",
      "args": ["-y", "@descript/mcp-server@0.1.0"],
      "env": {
        "DESCRIPT_TOKEN": "${DESCRIPT_TOKEN}"
      }
    },
    "docusign": {
      "command": "npx",
      "args": ["-y", "@docusign/mcp-server@0.1.0"],
      "env": {
        "DOCUSIGN_TOKEN": "${DOCUSIGN_TOKEN}",
        "DOCUSIGN_ACCOUNT_ID": "${DOCUSIGN_ACCOUNT_ID}"
      }
    },
    "paypal": {
      "command": "npx",
      "args": ["-y", "@paypal/mcp-server@0.1.0"],
      "env": {
        "PAYPAL_CLIENT_ID": "${PAYPAL_CLIENT_ID}",
        "PAYPAL_CLIENT_SECRET": "${PAYPAL_CLIENT_SECRET}"
      }
    }
  }
}
